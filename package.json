{
  "name": "@tsonic/target-csharp",
  "version": "0.0.1",
  "description": "C# target pack for Tsonic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
