<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../../../.temp/native-runtime/restore/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Tsonic.NativeConstruction</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IntermediateOutputPath Condition="'$(TsonicProofSourceRoot)' != ''">$(TsonicProofSourceRoot)obj/$(Configuration)/</IntermediateOutputPath>
    <OutputPath Condition="'$(TsonicProofSourceRoot)' != ''">$(TsonicProofSourceRoot)bin/$(Configuration)/</OutputPath>
  </PropertyGroup>
  <Import Project="$(TsonicProofSourceRoot)NativeReferences.props" Condition="'$(TsonicProofSourceRoot)' != ''" />
  <ItemGroup Condition="'$(TsonicProofSourceRoot)' != ''">
    <Compile Include="$(TsonicProofSourceRoot)**/*.cs" Exclude="$(TsonicProofSourceRoot)obj/**;$(TsonicProofSourceRoot)bin/**" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Target Name="RequireNativeProofSources" BeforeTargets="CoreCompile">
    <Error Condition="'$(TsonicProofSourceRoot)' == ''" Text="Native proof builds require their private source and output directory." />
  </Target>
</Project>
